# Copy to .env and replace all CHANGE_ME values. Never commit .env.
DB_NAME=orchard_mall
DB_USER=orchard
DB_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT_PASSWORD
MINIO_ACCESS_KEY=CHANGE_ME_LOCAL_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_LOCAL_MINIO_SECRET
MINIO_BUCKET=orchard-media
ADMIN_INIT_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS
ADMIN_ORIGIN=http://localhost:5173
TARO_APP_API_BASE=http://127.0.0.1:18084
DEV_CONSUMER_LOGIN_ENABLED=true
DEV_PAYMENT_ENABLED=true
DEV_REFUND_ENABLED=true
SPRING_PROFILES_ACTIVE=dev
# Single-merchant channel identity expected in verified payment events.
PAYMENT_MERCHANT_SUBJECT=orchard-mall-local
# Optional host-port isolation when defaults are already occupied.
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
NGINX_PORT=8088
